# Copy to .env and fill in. .env is gitignored -- never commit real keys.

# API key for the OpenAI-compatible gateway.
BULLSAI_API_KEY=your-key-here

# Root of the OpenAI-compatible API, ending in /v1
BASE_URL=https://example.invalid/v1

# Model id to use for the agent loop.
MODEL=zai-org/GLM-5.2
IMG_MODEL=Qwen/Qwen-Image-2512

# Sampling temperature. Keep at 0 for deterministic tool selection.
TEMPERATURE=0



# 18 models available:

#   BAAI/bge-m3
#   BAAI/bge-reranker-v2-m3
#   Qwen/Qwen-Image-2512
#   Qwen/Qwen3.6-27B
#   black-forest-labs/FLUX.1-schnell
#   black-forest-labs/FLUX.2-dev
#   google/embeddinggemma-300m
#   google/gemma-3-27b-it
#   google/gemma-4-31B-it
#   google/gemma-4-E4B-it
#   legacy
#   meta-llama/Llama-3.1-8B-Instruct
#   meta-llama/Llama-4-Maverick-17B-128E-Instruct-FP8
#   mistralai/Ministral-3-14B-Instruct
#   openai/gpt-oss-120b
#   openai/gpt-oss-20b
#   zai-org/GLM-4.7-Flash
