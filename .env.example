# Copy to .env and fill in. .env is gitignored -- never commit real keys.

# API key for the OpenAI-compatible gateway.
BULLSAI_API_KEY=your-key-here

# Root of the OpenAI-compatible API, ending in /v1
BASE_URL=https://example.invalid/v1

# Model id to use for the agent loop.
MODEL=zai-org/GLM-5.2

# Sampling temperature. Keep at 0 for deterministic tool selection.
TEMPERATURE=0
